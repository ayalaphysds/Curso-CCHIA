# Variables de entorno para Gate 3 (CENABAST Capstone)
# Copia este archivo a .env para ejecucion local. NUNCA subas .env a Git.

# Secreto: clave API de Google Gemini (dejar vacio en plantilla; solo necesaria con MODELO=real)
GEMINI_API_KEY=

# Configuracion operativa
ENTORNO=desarrollo
MODELO=simulado
PERMITIR_RESPALDO=0
UMBRAL_SOBREPRECIO_PCT=15.0
